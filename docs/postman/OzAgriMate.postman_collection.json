              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Live weather used\", () => pm.expect(r.supportingData.weatherSource).to.eql(\"LIVE\"));",
                  "pm.test(\"Rain forecast so no irrigation\", () => pm.expect(r.action).to.eql(\"NO_IRRIGATION\"));"
                ]
              }
            }
          ]
