    {
      "name": "AI & Irrigation Service (Role B)",
      "item": [
        {
          "name": "API 6 POST recommendation - valid (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{irrigationUrl}}/farms/farm-001/recommendations",
              "host": [
                "{{irrigationUrl}}"
              ],
              "path": [
                "farms",
                "farm-001",
                "recommendations"
              ]
            },
            "description": "farm-001 is configured as a simulated weather outage, so the forecast comes from the cache. If the Monitoring service is running, the reading comes from it (reading-001, 18.4).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cropType\": \"wheat\",\n  \"requestedBy\": \"farmer-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"recId\", r.recommendationId);",
                  "pm.test(\"Starts as PENDING_APPROVAL (ADR-07)\", () => pm.expect(r.status).to.eql(\"PENDING_APPROVAL\"));",
                  "pm.test(\"Uses cached weather during simulated outage (ADR-08)\", () => pm.expect(r.supportingData.weatherSource).to.eql(\"CACHED\"));"
                ]
              }
            }
          ]
        },
