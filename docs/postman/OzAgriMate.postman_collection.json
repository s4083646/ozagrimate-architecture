          "name": "POST reading - valid (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{monitoringUrl}}/farms/farm-001/readings",
              "host": [
                "{{monitoringUrl}}"
              ],
              "path": [
                "farms",
                "farm-001",
                "readings"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"readingId\": \"reading-001\",\n  \"deviceId\": \"sensor-001\",\n  \"soilMoisture\": 18.4,\n  \"timestamp\": \"2026-10-19T03:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Reading saved\", () => pm.expect(pm.response.json().readingId).to.eql(\"reading-001\"));"
                ]
              }
            }
          ]
