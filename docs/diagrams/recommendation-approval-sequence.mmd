%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, Helvetica, sans-serif","fontSize":"15px","actorBkg":"#ffffff","actorBorder":"#3b4252","actorTextColor":"#111","signalColor":"#3b4252","signalTextColor":"#111","noteBkgColor":"#fff4c2","noteBorderColor":"#c9a227","labelBoxBkgColor":"#eef5ff","labelBoxBorderColor":"#2563eb","altSectionBkgColor":"#f7f9fc"},"sequence":{"mirrorActors":false,"messageMargin":30,"boxMargin":8,"noteMargin":8,"actorMargin":40,"wrap":true,"width":170}}}%%
sequenceDiagram
    title Irrigation Recommendation and Approval (UML Sequence Diagram)
    actor F as Farmer
    actor A as Agronomist
    participant C as Recommendation Controller
    participant R as Recommendation Service
    participant S as Sensor Data Client
    participant M as Monitoring & Alert Service
    participant W as Weather Integration
    participant P as Approval Service
    participant DB as Recommendation Repository

    F->>C: POST /farms/farm-001/recommendations {cropType}
    activate C
    C->>R: generate(farmId, request)
    activate R
    R->>S: latestReading(farmId)
    activate S
    S->>M: GET /farms/farm-001/readings/latest
    alt Monitoring service available
        M-->>S: 200 OK {readingId, soilMoisture}
    else Unavailable or timeout (2 s)
        S->>S: Use fallback reading
    end
    S-->>R: SensorSnapshot
    deactivate S
    R->>W: forecastFor(farmId)
    activate W
    alt External weather API available
        W-->>R: Forecast (source LIVE)
    else API unavailable
        W-->>R: Cached forecast (source CACHED, age in minutes)
    end
    deactivate W
    R->>R: Apply irrigation rules
    R->>DB: save(recommendation, PENDING_APPROVAL)
    R-->>C: Recommendation
    deactivate R
    C-->>F: 201 Created {status: PENDING_APPROVAL}
    deactivate C

    A->>C: GET .../recommendations/rec-001
    activate C
    C->>R: get(farmId, id)
    R->>DB: findByFarmAndId(farmId, id)
    DB-->>R: Recommendation
    R-->>C: Recommendation
    C-->>A: 200 OK {supportingData, status}
    deactivate C

    A->>C: PUT .../rec-001/approval [X-User-Role: AGRONOMIST] {decision}
    activate C
    C->>P: review(farmId, id, role, request)
    activate P
    alt Role is not AGRONOMIST
        P-->>C: ForbiddenException
        C-->>A: 403 Forbidden
    else Already reviewed
        P-->>C: ConflictException
        C-->>A: 409 Conflict
    else Valid pending recommendation
        P->>DB: save(recommendation, APPROVED or REJECTED)
        P-->>C: Reviewed recommendation
        C-->>A: 200 OK {status: APPROVED}
    end
    deactivate P
    deactivate C
