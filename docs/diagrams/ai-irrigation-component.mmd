%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, Helvetica, sans-serif","edgeLabelBackground":"#ffffff","fontSize":"15px","lineColor":"#3b4252","primaryTextColor":"#111"},"flowchart":{"defaultRenderer":"elk","curve":"step","nodeSpacing":45,"rankSpacing":70,"htmlLabels":true}}}%%
flowchart TB
    title["<b>OzAgriMate - AI & Irrigation Service - C4 Component Diagram (Level 3)</b>"]:::title

    farmer["<b>Farmer</b><br/>[Person]<br/>Requests irrigation recommendations for their farm"]:::person
    agro["<b>Agronomist</b><br/>[Person]<br/>Reviews and approves or rejects AI recommendations"]:::person

    subgraph AIS["AI & Irrigation Service [Container: Java / Spring Boot, Port 8083]"]
        direction TB
        ctrl["<b>Recommendation Controller</b><br/>[Component: Spring REST Controller]<br/>Exposes the generate, retrieve and approval endpoints"]:::comp
        err["<b>API Exception Handler</b><br/>[Component: Spring RestControllerAdvice]<br/>Maps errors to 400, 403, 404 and 409 responses"]:::comp
        rec["<b>Recommendation Service</b><br/>[Component: Spring Service]<br/>Applies irrigation rules and creates PENDING_APPROVAL recommendations"]:::comp
        appr["<b>Approval Service</b><br/>[Component: Spring Service]<br/>Checks agronomist role and enforces PENDING_APPROVAL to APPROVED or REJECTED"]:::comp
        farmreg["<b>Farm Registry</b><br/>[Component: Spring Component]<br/>Validates farm IDs (seeded in prototype)"]:::comp
        sensor["<b>Sensor Data Client</b><br/>[Component: Spring RestClient]<br/>Fetches latest soil moisture, uses fallback reading if unavailable"]:::comp
        weather["<b>Weather Integration</b><br/>[Component: Spring Service]<br/>Fetches forecasts, falls back to cached data and records its age"]:::comp
        repo["<b>Recommendation Repository</b><br/>[Component: In-memory ConcurrentHashMap]<br/>Stores recommendations and review details"]:::comp
    end

    monitoring["<b>Monitoring & Alert Service</b><br/>[Container: Java / Spring Boot, Port 8082]<br/>Validates readings and provides the latest sensor data"]:::container
    farmdev["<b>Farm & Device Service</b><br/>[Container: Java / Spring Boot, Port 8081]<br/>Manages farms and registered IoT devices"]:::container
    store["<b>Persistent Data Store</b><br/>[Container: Database, proposed]<br/>Stores recommendation data in production"]:::proposed
    wprov["<b>Weather & Climate Data Provider</b><br/>[External System]<br/>External API for forecasts and weather information"]:::external
    ics["<b>Irrigation Control System</b><br/>[External System]<br/>External equipment executes irrigation commands"]:::external

    title ~~~ farmer
    farmer -- "Requests recommendation<br/>[POST, HTTPS/JSON]" --> ctrl
    agro -- "Retrieves and reviews recommendation<br/>[GET / PUT, HTTPS/JSON]" --> ctrl
    ctrl -- "Generates and retrieves<br/>recommendations" --> rec
    ctrl -- "Submits review decision" --> appr
    ctrl -. "Errors handled by" .-> err
    appr -- "Loads recommendation" --> rec
    rec -- "Validates farm" --> farmreg
    rec -- "Requests latest reading" --> sensor
    rec -- "Requests forecast" --> weather
    rec -- "Saves and finds<br/>recommendations" --> repo
    appr -- "Saves review" --> repo
    sensor -- "Gets latest reading<br/>[GET /farms/{farmId}/readings/latest,<br/>HTTP/JSON]" --> monitoring
    weather -. "Fetches forecast<br/>[HTTPS/JSON, 3 s timeout]<br/>(simulated in prototype)" .-> wprov
    farmreg -. "Validates farm<br/>(proposed)" .-> farmdev
    repo -. "Replaced by database<br/>(proposed)" .-> store
    appr -. "Sends approved irrigation<br/>schedule (proposed)" .-> ics

    legend["<b>Legend</b><br/>Green = person<br/>White = component inside AI & Irrigation Service<br/>Blue border = other OzAgriMate container<br/>Purple dashed = proposed production infrastructure<br/>Grey = external system<br/>Dashed arrow = proposed or simulated interaction"]:::legend
    ics ~~~ legend

